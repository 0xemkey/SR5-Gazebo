from pathlib import Path
import os

from ament_index_python.packages import get_package_share_directory

from launch import LaunchDescription
from launch.actions import (
    IncludeLaunchDescription,
    RegisterEventHandler,
    TimerAction,
    SetEnvironmentVariable,
    EmitEvent,
    LogInfo,
)
from launch.event_handlers import OnProcessExit
from launch.events import Shutdown
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch_ros.actions import Node


def continue_if_success(next_actions, process_name):
    """Continue the launch chain only when the previous process succeeds."""

    def callback(event, context):
        if event.returncode == 0:
            return next_actions

        return [
            LogInfo(
                msg=(
                    f"[DUAL SR5] {process_name} failed "
                    f"with exit code {event.returncode}. "
                    "Stopping launch sequence."
                )
            ),
            EmitEvent(
                event=Shutdown(
                    reason=f"{process_name} failed"
                )
            ),
        ]

    return callback


def generate_launch_description():
    share = Path(get_package_share_directory("dual_sr5_sim"))
    gazebo_share = Path(get_package_share_directory("gazebo_ros"))
    rokae_share = Path(get_package_share_directory("rokae_description"))

    # Gazebo model search paths.
    model_paths = [
        str(share / "models"),
        str(rokae_share.parent),
    ]

    existing_model_path = os.environ.get("GAZEBO_MODEL_PATH", "")
    if existing_model_path:
        model_paths.append(existing_model_path)

    gazebo_model_path = ":".join(model_paths)

    # Controller configuration.
    controllers_yaml = str(share / "config/sr5_controllers.yaml")
    ros2_control_params = (
        "$(find dual_sr5_sim)/config/sr5_controllers.yaml"
    )

    # Load robot descriptions and resolve controller YAML paths.
    left_urdf = (
        (share / "urdf/xMateSR5_left.urdf")
        .read_text()
        .replace(ros2_control_params, controllers_yaml)
    )

    right_urdf = (
        (share / "urdf/xMateSR5_right.urdf")
        .read_text()
        .replace(ros2_control_params, controllers_yaml)
    )

    # Gazebo Classic.
    gazebo = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(
            str(gazebo_share / "launch/gazebo.launch.py")
        )
    )

    # Left robot state publisher.
    left_state_publisher = Node(
        package="robot_state_publisher",
        executable="robot_state_publisher",
        namespace="left",
        name="robot_state_publisher",
        parameters=[{
            "robot_description": left_urdf,
            "use_sim_time": True,
        }],
        output="screen",
    )

    # Right robot state publisher.
    right_state_publisher = Node(
        package="robot_state_publisher",
        executable="robot_state_publisher",
        namespace="right",
        name="robot_state_publisher",
        parameters=[{
            "robot_description": right_urdf,
            "use_sim_time": True,
        }],
        output="screen",
    )

    # Spawn table.
    spawn_table = Node(
        package="gazebo_ros",
        executable="spawn_entity.py",
        arguments=[
            "-entity", "dual_sr5_table",
            "-file", str(share / "models/dual_sr5_table.sdf"),
            "-x", "0",
            "-y", "0",
            "-z", "0",
        ],
        output="screen",
    )

    # Spawn left SR5.
    spawn_left = Node(
        package="gazebo_ros",
        executable="spawn_entity.py",
        arguments=[
            "-entity", "xMateSR5_left",
            "-topic", "/left/robot_description",
            "-robot_namespace", "/left",
            "-x", "-0.60",
            "-y", "-0.18",
            "-z", "0.78",
            "-R", "0",
            "-P", "0",
            "-Y", "0",
        ],
        output="screen",
    )

    # Spawn right SR5.
    spawn_right = Node(
        package="gazebo_ros",
        executable="spawn_entity.py",
        arguments=[
            "-entity", "xMateSR5_right",
            "-topic", "/right/robot_description",
            "-robot_namespace", "/right",
            "-x", "0.60",
            "-y", "-0.18",
            "-z", "0.78",
            "-R", "0",
            "-P", "0",
            "-Y", "0",
        ],
        output="screen",
    )

    # Left controller manager: start controllers separately.
    left_jsb = Node(
        package="controller_manager",
        executable="spawner",
        arguments=[
            "joint_state_broadcaster",
            "-c", "/left/controller_manager",
            "--controller-manager-timeout", "60",
        ],
        output="screen",
    )

    left_arm = Node(
        package="controller_manager",
        executable="spawner",
        arguments=[
            "arm_controller",
            "-c", "/left/controller_manager",
            "--controller-manager-timeout", "60",
        ],
        output="screen",
    )

    # Right controller manager: start controllers separately.
    right_jsb = Node(
        package="controller_manager",
        executable="spawner",
        arguments=[
            "joint_state_broadcaster",
            "-c", "/right/controller_manager",
            "--controller-manager-timeout", "60",
        ],
        output="screen",
    )

    right_arm = Node(
        package="controller_manager",
        executable="spawner",
        arguments=[
            "arm_controller",
            "-c", "/right/controller_manager",
            "--controller-manager-timeout", "60",
        ],
        output="screen",
    )

    # Windows F710 UDP -> ROS 2 /joy bridge.
    joy_bridge = Node(
        package="dual_sr5_sim",
        executable="udp_joy_bridge.py",
        name="udp_joy_bridge",
        output="screen",
    )

    # Dual-arm Cartesian inverse kinematics.
    ik_node = Node(
        package="dual_sr5_sim",
        executable="dual_sr5_gamepad_ik.py",
        name="dual_sr5_gamepad_ik",
        output="screen",
    )

    return LaunchDescription([
        SetEnvironmentVariable(
            name="GAZEBO_MODEL_PATH",
            value=gazebo_model_path,
        ),

        gazebo,
        left_state_publisher,
        right_state_publisher,

        # Wait for Gazebo before spawning the table.
        TimerAction(
            period=3.0,
            actions=[spawn_table],
        ),

        # Table -> left robot -> right robot.
        RegisterEventHandler(
            OnProcessExit(
                target_action=spawn_table,
                on_exit=continue_if_success(
                    [spawn_left], "Table spawn"
                ),
            )
        ),

        RegisterEventHandler(
            OnProcessExit(
                target_action=spawn_left,
                on_exit=continue_if_success(
                    [spawn_right], "Left robot spawn"
                ),
            )
        ),

        RegisterEventHandler(
            OnProcessExit(
                target_action=spawn_right,
                on_exit=continue_if_success(
                    [left_jsb], "Right robot spawn"
                ),
            )
        ),

        # Left controller manager.
        RegisterEventHandler(
            OnProcessExit(
                target_action=left_jsb,
                on_exit=continue_if_success(
                    [left_arm], "Left joint_state_broadcaster"
                ),
            )
        ),

        RegisterEventHandler(
            OnProcessExit(
                target_action=left_arm,
                on_exit=continue_if_success(
                    [right_jsb], "Left arm_controller"
                ),
            )
        ),

        # Right controller manager.
        RegisterEventHandler(
            OnProcessExit(
                target_action=right_jsb,
                on_exit=continue_if_success(
                    [right_arm], "Right joint_state_broadcaster"
                ),
            )
        ),

        RegisterEventHandler(
            OnProcessExit(
                target_action=right_arm,
                on_exit=continue_if_success(
                    [joy_bridge, ik_node], "Right arm_controller"
                ),
            )
        ),
    ])
